## ─── Public (client-side) ───────────────────────────────
# Endpoint API backend
NEXT_PUBLIC_API_URL=http://localhost:5003

# SSO Bagdja (bagdja-login UI — untuk OAuth authorize & logout)
NEXT_PUBLIC_AUTH_URL=https://login.bagdja.com
NEXT_PUBLIC_CLIENT_ID=website-builder-admin

# URL aplikasi admin (untuk redirect setelah logout SSO)
NEXT_PUBLIC_APP_URL=http://localhost:5004

# Redirect setelah callback OAuth
NEXT_PUBLIC_REDIRECT_URI=http://localhost:5004/auth/callback

## ─── Server-side (jangan expose ke client) ──────────────
# Secret untuk exchange authorization code → access token
OAUTH_CLIENT_SECRET=change-me

# Session/cookie encryption key
SESSION_ENCRYPTION_KEY=change-me-32-byte-hex-secret

# Upstash Redis — penyimpanan sementara code_verifier + next path OAuth
# (bukan cookie, karena Safari semua mode tidak konsisten menyimpan
# Set-Cookie yang menempel di response redirect). `state` yang dikirim ke
# IdP cuma ID pendek — lihat app/lib/oauth-state-store.ts untuk alasan
# lengkap (termasuk kenapa bukan lagi state terenkripsi di URL).
# Setup: Vercel Dashboard → project ini → tab Storage → Create Database →
# pilih provider Upstash → Redis. Nama env var yang muncul bisa
# KV_REST_API_URL/KV_REST_API_TOKEN (konvensi Vercel Marketplace) ATAU
# UPSTASH_REDIS_REST_URL/UPSTASH_REDIS_REST_TOKEN (konvensi Upstash
# langsung) — kode menerima keduanya, isi salah satu pasangan saja.
KV_REST_API_URL=change-me
KV_REST_API_TOKEN=change-me
